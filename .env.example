# ---- Brain: your Mind (same three settings as Puppy v2 / trio-chat) ----
PROVIDER=minds                     # or "mock" to try the buddy without a key
MINDS_BUILDER_API_KEY=             # build.hellominds.ai/console
MIND_ID=                           # the Mind's UUID or its name
# MINDS_TIMEOUT_MS=150000           # how long to wait for an answer (late answers still show up)
# BUDDY_FULL_NOTE=on               # send the full personality + tag rules with every message (only if you can't add mind-instructions.md to your Mind)

# ---- Voice (optional): ElevenLabs OR OpenAI ----
# Either key gives the buddy a real voice AND lets you talk to it (speech-to-text).
# With neither: Windows' built-in voice for speaking, typing only for talking to it.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=             # any voice id from your ElevenLabs Voices page (default: premade "Sarah")
# ELEVENLABS_MODEL=eleven_multilingual_v2   # or eleven_flash_v2_5 for faster, cheaper replies
OPENAI_API_KEY=
# BUDDY_VOICE=coral                # OpenAI voice: coral, sage, ballad, verse, alloy, ash, echo, shimmer…
# VOICE_PROVIDER=elevenlabs        # only needed if you set both keys

# ---- Music (optional) ----
# Internet radio works with no key. For YouTube songs, add a free YouTube Data API key (see README "Music").
YOUTUBE_API_KEY=

# ---- Google Calendar + Drive (optional; see README "Connect Google") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Behaviour ----
# IDLE_MINUTES=5                   # nap after this many minutes without keyboard/mouse
# DOZE_MINUTES=5                   # doze after this many minutes with nothing to do, even while you work (0 = never)
# DOG_NAME=                        # your dog's name, used in the dreams
# DIM_AFTER_MINUTES=2              # once napping, fade out after this many more minutes
# DIM_OPACITY=0.35                 # how see-through when faded (0 = invisible, 1 = solid)
# HANDS_FREE=on                    # start with hands-free listening ("Hey <name>") switched on
# MEETING_ALERT_MINUTES=10         # first meeting heads-up
# TIMELINE_DAYS=3                  # how long the "what you were doing" timeline is kept
# IGNORE_APPS=keepass,1password,bitwarden,lastpass,dashlane   # never recorded (titles hidden too)
# IGNORE_TITLES=                   # EXTRA words: windows whose title contains them are never noted (login, sign-in, banking, password,
#                                  # verification/OTP pages and private browsing are always skipped)
# SHARE_TITLES=on                  # send full window titles to your Mind with each message (default: app name only)

